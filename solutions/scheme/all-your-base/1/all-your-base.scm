(import (rnrs))

(define (rebase in-base digits out-base)
  (when (< in-base 2)
    (error 'rebase "input base must be >= 2" in-base))
  (when (< out-base 2)
    (error 'rebase "output base must be >= 2" out-base))
  (let ingress ((digits digits)
                (acc 0))
    (if (null? digits)
      (if (zero? acc)
        '(0)
        (let egress ((acc acc)
                     (result '()))
          (if (zero? acc)
             result
            (egress (quotient acc out-base) (cons (remainder acc out-base) result)))))
      (let ((digit (car digits)))
        (unless (< -1 digit in-base)
          (error 'rebase "all digits must satisfy 0 <= d < input base" digit))
        (ingress (cdr digits) (+ (* in-base acc) digit))))))